generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  type      String   // "NEW" or "EXISTING"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls        CallLog[]
  payments     Payment[]
  interactions Interaction[]
}

model CallLog {
  id         String   @id @default(uuid())
  userId     String?
  intent     String
  category   String   @default("General") // "Sales", "Support", "Billing", "General"
  duration   Int      // in seconds
  sentiment  String   @default("Neutral") // "Positive", "Neutral", "Negative"
  status     String   @default("Completed") // "Completed", "Failed", "Transferred"
  summary    String?
  transcript String?
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}


model Interaction {
  id        String   @id @default(uuid())
  userId    String
  role      String   // "USER" or "AI"
  message   String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Package {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  createdAt   DateTime @default(now())
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  status    String   // "PAID", "PENDING", "FAILED"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
